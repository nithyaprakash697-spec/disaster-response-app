# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEB PUSH NOTIFICATION VAPID KEYS
# VITE_VAPID_PUBLIC_KEY: Public key used on the frontend to subscribe to Web Push.
VITE_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa1F-EXAMPLE_VAPID_PUBLIC_KEY"

# VAPID_PRIVATE_KEY: Private key used on server-side / Supabase Edge Function to send Web Push messages.
VAPID_PRIVATE_KEY="EXAMPLE_VAPID_PRIVATE_KEY"

# NASA FIRMS API KEY
# VITE_FIRMS_API_KEY: Free API key for NASA FIRMS satellite fire/hotspot detection.
VITE_FIRMS_API_KEY="EXAMPLE_FIRMS_MAP_KEY_12345"
